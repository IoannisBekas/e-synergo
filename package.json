{
  "name": "e-synergo",
  "version": "1.0.0",
  "private": true,
  "description": "Website for e_synergo - Special Therapy Center, Acharnes",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --watch",
    "optimize:images": "node scripts/optimize-images.mjs",
    "build": "npm run build:css && npm run optimize:images"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19"
  }
}
